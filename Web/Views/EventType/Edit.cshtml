@model Web.ViewModels.EventType.UpdateEventTypeViewModel


<div class="w3-card">
	<h1>Edytuj typ wydarzenia</h1>
	<div class="w3-container">
	<form asp-controller="EventType" asp-action="Edit" method="post">
		<p>
			<label asp-for="Name">Nazwa:</label>
			<input asp-for="Name" class="w3-input w3-border" />
			<span asp-validation-for="Name" class="w3-text-red"></span>
		</p>

		<p>
			<label asp-for="Description">Opis:</label>
			<input asp-for="Description" class="w3-input w3-border"/>
				<span asp-validation-for="Name" class="w3-text-red"></span>
		</p>
		<p>
			<button type="submit" class="w3-button w3-green">Edytuj</button>
			<a asp-controller="EventType" asp-action="Index" class="w3-button w3-grey">Cancel</a>
		</p>
	</form>
	</div>
</div>