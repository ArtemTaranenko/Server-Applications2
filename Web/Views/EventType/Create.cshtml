@model Web.ViewModels.EventType.CreateEventTypeViewModel

<div class="w3-card">
	<h1>Dodaj typ wydarzenia</h1>
	<div class="container">
		<form asp-controller="EventType" asp-action="Create" method="post">
			<p>
				<label asp-for="Name">Nazwa: </label>
				<input asp-for="Name" class="w3-input w3-border"/>
			</p>
			<p>
				<label asp-for="Description">Opis:</label>
				<input asp-for="Description" class="w3-input w3-border" />
			</p>
			<p>
				<button type="submit" class="w3-button w3-green">Dodaj</button>
				<a asp-controller="EventType" asp-action="Index" class="w3-button w3-grey">Cancel</a>
			</p>
		</form>
	</div>
</div>