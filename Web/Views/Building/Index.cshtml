@model List<Web.ViewModels.Building.BuildingListItemViewModel>

<title>Lista budynków </title>
<div class="w3-class w3-container">
	<p>
		<a asp-controller="Building" asp-action="Create" class="w3-button w3-blue w3-hover-blue-grey">Dodaj budynek</a>
	</p>
	<div class="w3-card">
		<table class="w3-table-all w3-hoverable">
			<thead>
				<tr class="w3-light-grey">
					<th>Nazwa</th>
					<th>Adres</th>
					<th>Opis</th>
					<th class="w3-center-align">Akcje</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var building in Model)
				{
					<tr>
						<td>@building.Name</td>
						<td>@building.Address</td>
						<td>@building.Description</td>
						<td> <a asp-controller="Building" asp-action="Details" asp-route-id="@building.Id" class="w3-button w3-purple"> Sczegóły </a> 
							<a asp-controller="Building" asp-action="Edit" asp-route-id="@building.Id" class="w3-button w3-green"> Edytuj </a>
							<a asp-controller="Building" asp-action="Delete" asp-route-id="@building.Id" class="w3-button w3-red"> Usuń </a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>