@model Web.ViewModels.Equipment.CreateEquipmentViewModel

<div class="w3-card">

	<h1> Dodaj wyposażenie</h1>

	<div class="w3-container">

		<form asp-controller="Equipment" asp-action="Create" method="post">
			<p>
				<label asp-for="Name">Nazwa:</label>
				<input asp-for="Name" class="w3-input w3-border"/>
			</p>
			<p>
				<label asp-for="Description">Opis:</label>
				<input asp-for="Description" class="w3-input w3-border" />
			</p>
			<p>
				Czy jest przenośne?
				<label>
					<input type="radio" asp-for="IsMobile" value="true" />
					Tak
				</label>

				<label>
					<input type="radio" asp-for="IsMobile" value="false" />
					Nie
				</label>
			</p>
			<p>
				<button type="submit" class="w3-button w3-green">Dodaj</button>
				<a class="w3-button w3-grey" asp-controller="Equipment" asp-action="Index">Cancel</a>
			</p>
		</form>

	</div>

</div>