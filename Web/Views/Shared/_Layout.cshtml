
<!DOCTYPE html>
<html lang="pl">
<head>
	<meta charset="utf-8" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
</head>
<body>
	<div class="w3-content" style="max-width:1500px">
		<header class="w3-panel w3-center w3-opacity">
			<nav class="w3-bar w3-border">
				<a class="w3-bar-item w3-button" asp-controller="Home" asp-action="Index"> Home</a>
				<a class="w3-bar-item w3-button" asp-controller="Building" asp-action="Index"> Buildings</a>
				<a class="w3-bar-item w3-button" asp-controller="EventType" asp-action="Index">EventTypes</a>
				<a class="w3-bar-item w3-button" asp-controller="Equipment" asp-action="Index">Equipments</a>
				<a class="w3-bar-item w3-button" asp-controller="Room" asp-action="Index">Rooms</a>
			</nav>
		</header>
		<main>
			@await Html.PartialAsync("_Messages")
			@RenderBody()
		</main>

		<footer class="w3-panel w3-center">
			&copy; 2026
		</footer>
	</div>
</body>
</html>